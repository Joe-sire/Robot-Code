#include <esp_now.h>
#include <WiFi.h>

// code for my line following robot

const int HI_SPD = 125;

// ENA, IN1, IN2 for left motor
const int LEN = 25;
const int LIN1 = 27;
const int LIN2 = 26;

// ENB, IN3, IN4 for right motor
const int RIN1 = 14;
const int RIN2 = 12;
const int REN = 13;

// vars for sensors on line following thingy, 
// outer left
const int SS1Pin = 18;
// inner left
const int SS2Pin = 17;
// center
const int SS3Pin = 16;
// inner right
const int SS4Pin = 2;
// outer right
const int SS5Pin = 15;

// if outer left turn left fast, if inner left turn left slow
// if outer right turn right fast, if inner right turn right slow

// def pin modes
void setup() {
 pinMode(LEN, OUTPUT);
 pinMode(LIN1, OUTPUT);
 pinMode(LIN2, OUTPUT);
 pinMode(RIN1, OUTPUT);
 pinMode(RIN2, OUTPUT);
 pinMode(REN, OUTPUT);
 pinMode(SS1Pin, INPUT);
 pinMode(SS2Pin, INPUT);
 pinMode(SS3Pin, INPUT);
 pinMode(SS4Pin, INPUT);
 pinMode(SS5Pin, INPUT);
 Serial.begin(9600);
}



void loop() {
// values for line following
int SS1 = digitalRead(SS1Pin);
int SS2 = digitalRead(SS2Pin);
int SS3 = digitalRead(SS3Pin);
int SS4 = digitalRead(SS4Pin);
int SS5 = digitalRead(SS5Pin);

// debug sensor outputs, 1 is white 0 is black
// for sensor LEDs on is black off is white
int debug = 0;

if  (debug == 1) {
  Serial.print("SS1: ");
  Serial.print(SS1);
  Serial.print(" SS2: ");
  Serial.print(SS2);
  Serial.print(" SS3: ");
  Serial.print(SS3);
  Serial.print(" SS4: ");
  Serial.print(SS4);
  Serial.print(" SS5: ");
  Serial.print(SS5);
  Serial.println();
}

 if (SS1 == 1 && SS5 == 0) {
	leftMotorForwardsFast();	
 } else if (SS5 == 1 && SS1 == 0) {
	rightMotorForwardsFast();	
 } else if (SS2 == 1 && SS4 == 0) {
  leftMotorForwardsSlow();
 } else if (SS4 == 1 && SS2 == 0) {
  rightMotorForwardsSlow();
 } else if (SS1 == 0 && SS2 == 0 && SS3 == 0 && SS4 == 0 && SS5 == 0) {
  leftMotorStop();
  rightMotorStop();
  delay(800);
  stopAtStation();
 } else {
 bothMotorForwards();
 }
}


// move the right motor forwards slowly
void rightMotorForwardsSlow() {
 digitalWrite(LIN2, LOW);
 digitalWrite(LIN1, HIGH);
 analogWrite(LEN, HI_SPD);

 digitalWrite(RIN2, LOW);
 digitalWrite(RIN1, HIGH);
 analogWrite(REN, HI_SPD);
 delay(10); 
 analogWrite(LEN, 0);
 delay(10); 
 analogWrite(REN, 0);
 delay(15);
}

// move the left motor forwards slowly
void leftMotorForwardsSlow() {
 digitalWrite(RIN2, LOW);
 digitalWrite(RIN1, HIGH);
 analogWrite(REN, HI_SPD);

 digitalWrite(LIN2, LOW);
 digitalWrite(LIN1, HIGH);
 analogWrite(LEN, HI_SPD);
 delay(10); 
 analogWrite(REN, 0);
 delay(10); 
 analogWrite(LEN, 0);
 delay(15);
}

// sharp turn right: left wheel forwards, right wheel backwards
void leftMotorForwardsFast() {
 digitalWrite(LIN2, LOW);
 digitalWrite(LIN1, HIGH);
 analogWrite(LEN, HI_SPD);

 digitalWrite(RIN2, HIGH);
 digitalWrite(RIN1, LOW);
 analogWrite(REN, HI_SPD);

 delay(48);
 analogWrite(LEN, 0);
 analogWrite(REN, 0);
 delay(8);
}

// sharp turn left: right wheel forwards, left wheel backwards
void rightMotorForwardsFast() {
 digitalWrite(RIN2, LOW);
 digitalWrite(RIN1, HIGH);
 analogWrite(REN, HI_SPD);

 digitalWrite(LIN2, HIGH);
 digitalWrite(LIN1, LOW);
 analogWrite(LEN, HI_SPD);

 delay(48);
 analogWrite(LEN, 0);
 analogWrite(REN, 0);
 delay(8);
}

// move both motors forwards
void bothMotorForwards() {
  digitalWrite(RIN2, LOW);
  digitalWrite(RIN1, HIGH);
  digitalWrite(LIN2, LOW);
  digitalWrite(LIN1, HIGH);
  analogWrite(REN, HI_SPD);
  analogWrite(LEN, HI_SPD);
  delay(30);
  analogWrite(REN, 0);
  analogWrite(LEN, 0);
  delay(8);
}


// move both motors forwards for a longer period of time after a stop (temporary, untill I get package handling working)
void stopAtStation() {
  digitalWrite(RIN2, LOW);
  digitalWrite(RIN1, HIGH);
  digitalWrite(LIN2, LOW);
  digitalWrite(LIN1, HIGH);
  analogWrite(REN, HI_SPD);
  analogWrite(LEN, HI_SPD);
  delay(200); 
  analogWrite(REN, 0);
  analogWrite(LEN, 0);
  delay(50); 
}

// stop the left motor
void leftMotorStop() {
  analogWrite(LEN, 0);
}

// stop the right motor
void rightMotorStop() {
  analogWrite(REN, 0);
}
